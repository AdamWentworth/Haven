# The container port remains private to the host by default.
HAVEN_PORT=5080

# Exact browser origin used for passkeys and anti-forgery checks. Keep this on
# localhost for the checked-in Compose baseline; a future private deployment
# must set its externally visible HTTPS origin here.
HAVEN_PUBLIC_ORIGIN=http://localhost:5080

# Historical posture observations are expired automatically. Live connection
# metadata is never written to history.
HAVEN_RETENTION_DAYS=90

# The local hub observes its own host continuously. Durations from 1m through
# 24h are accepted; enrolled agents retain their own reporting schedules.
HAVEN_COLLECTION_INTERVAL=15m
